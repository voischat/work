# Copy to .env, or run `pnpm env:setup` to render it from 1Password.
# Only VITE_WEB_SOCK is read by the app today; `pnpm dev:prod` proxies /v1 and
# /v2 to https://api.voischat.cn, and the production Worker proxies the same
# paths, so the app calls the API same-origin.
VITE_WEB_SOCK=wss://wss.weila.hk:8899
