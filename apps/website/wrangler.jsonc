{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "work-web",
  "main": "../../infra/cloudflare/proxy-worker.ts",
  "account_id": "f1aeb479314b25d24bd6626e9e5bbfe9",
  "compatibility_date": "2026-11-24",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/v2/*"]
  }
}
