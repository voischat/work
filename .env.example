# Shell variables for the verification skills and for manual deploys.
# Rendered to `~/.voischat/env.sh` by `pnpm env:setup` and sourced from ~/.zshrc,
# so every terminal and every worktree sees the same values.
# Never commit real values.
WEILA_QA_ACCOUNT=
WEILA_QA_PASSWORD=
# Only needed to deploy from this machine; CI uses the repo secret instead.
CLOUDFLARE_API_TOKEN=
