WEILA_TEST_PASSWORD={{ op://Personal/Weila Work env/WEILA_TEST_PASSWORD }}
WEILA_TEST_APP_ID={{ op://Personal/Weila Work env/WEILA_TEST_APP_ID }}
WEILA_TEST_APP_KEY={{ op://Personal/Weila Work env/WEILA_TEST_APP_KEY }}
WEILA_TEST_WSS={{ op://Personal/Weila Work env/WEILA_TEST_WSS }}
WEILA_TEST_COUNTRY_CODE={{ op://Personal/Weila Work env/WEILA_TEST_COUNTRY_CODE }}
WEILA_TEST_MD5={{ op://Personal/Weila Work env/WEILA_TEST_MD5 }}
WEILA_TEST_PEER_ACCOUNT={{ op://Personal/Weila Work env/WEILA_TEST_PEER_ACCOUNT }}
WEILA_TEST_PEER_PASSWORD={{ op://Personal/Weila Work env/WEILA_TEST_PEER_PASSWORD }}
WEILA_TEST_PEER_COUNTRY_CODE={{ op://Personal/Weila Work env/WEILA_TEST_PEER_COUNTRY_CODE }}
