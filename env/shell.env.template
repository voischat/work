# Source of truth: 1Password -> Personal -> "Weila Work env".
# `pnpm env:setup` renders this into ~/.voischat/env.sh (mode 0600), which
# ~/.zshrc sources. Used by .claude/skills/verify-*.
export WEILA_QA_ACCOUNT={{ op://Personal/Weila Work env/WEILA_QA_ACCOUNT }}
export WEILA_QA_PASSWORD={{ op://Personal/Weila Work env/WEILA_QA_PASSWORD }}
# CLOUDFLARE_API_TOKEN is not stored yet: deploys use the GitHub repo secret and
# the wrangler OAuth login. Add a field to the item and a line here if you mint one.
