{
  // knip finds unused files, exports and dependencies across the monorepo.
  // Run: pnpm knip  (gate must stay green; fix new findings, don't ignore them)
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The CI workflow installs the browser through the Playwright CLI, which knip
  // cannot resolve from a package import.
  // The parity gate resolves these through require.resolve from packages/core.
  // `op` comes from the 1Password CLI install, not from node_modules.
  "ignoreBinaries": ["op"],
  "workspaces": {
    ".": {
      // tsdown and vue-tsc are resolved by packages/core/scripts/typecheck-parity.mjs.
      // tsrs is oxlint's type-aware backend, resolved at runtime rather than imported.
      "ignoreDependencies": ["tsdown", "tsrs", "vue-tsc"],
      "entry": [
        // consumed by `pnpm run up` (taze)
        "taze.config.ts",
        // read by `void deploy` for the docs site
        "docs/void.config.ts",
        // commit-hook and release script specs, run through `node --test`
        "scripts/*.spec.ts",
        "scripts/release/*.spec.ts",
        // agent verification scripts, run ad hoc through ego-browser
        ".claude/skills/**/*.mjs",
        // repo scripts, including the manifest policy check
        "scripts/*.ts",
        // release entrypoints, invoked by .github/workflows/release.yml
        "scripts/release/*.ts",
        // user manual site, driven by root docs: scripts
        "docs/.vitepress/config.mts",
      ],
    },
    "apps/mock": {
      "entry": ["routes/*.ts", "void.config.ts"],
    },
    "apps/website": {
      // Knip analyzes vite.config.ts statically. Loading it executes the
      // UnoCSS and rspack plugin setup, which needs app env vars and prints
      // errors during the gate. The single ~ alias matches tsconfig paths.
      "vite": { "config": [] },
      "entry": [
        // auto-read by unplugin-vue-macros during the vite build
        "vue-macros.config.ts",
      ],
      "ignoreDependencies": [
        // icon sets resolved to CSS by UnoCSS/Iconify at build time
        "@iconify-json/carbon",
        "@iconify-json/ph",
      ],
    },
    "packages/core": {
      // Manual script: copies dist/assets into the consuming app's public/
      // (documented in packages/core/AGENTS.md, used by UniApp integrations)
      "entry": ["post-copy.js", "scripts/*.spec.mjs"],
      // Vendored Oxlint plugin. It is loaded by Oxlint, not imported by package code.
      // weilapb.js is generated protocol code; its default export is unused.
      "ignore": ["tools/oxlint/anti-slop/**", "src/proto/weilapb.js"],
      // Invoked by `src/proto/proto_raws/buildjs.sh` through `pnpm exec`, which knip cannot see.
      "ignoreDependencies": ["protobufjs-cli"],
    },
    "packages/ui": {
      // Icons are resolved at build time from CSS: `@plugin "@iconify/tailwind4"`
      // auto-discovers installed @iconify-json/* packages (see style.postcss.css)
      "ignoreDependencies": ["@iconify-json/carbon"],
      "entry": [
        // read by `void deploy`
        "void.config.ts",
      ],
    },
  },
  "rules": {
    // TrackType members are used inside .vue script/template blocks (group
    // page, EditMemberModal); knip's enum-member tracing does not follow
    // member access there
    "enumMembers": "off",
  },
  "ignore": [
    // Injected into the Arco theme through a less `hack` string in
    // vite.config.ts (line ~84); invisible to static import analysis
    "apps/website/src/assets/style/breakpoint.less",
    // AudioWorklet bundles fetched at runtime by URL (same pattern as packages/core)
    "apps/website/public/*.worklet.iife.js",
    "apps/playground-vue3/public/**",
    // tsnapi commits public-API snapshots under __snapshots__/tsnapi/
    "**/__snapshots__/**",
    // Generated build output, gitignored but present on disk after builds
    "**/dist/**",
  ],
}
