{
  "name": "weila-work-cli",
  "type": "module",
  "version": "0.0.4",
  "description": "CLI for Weila Work management APIs",
  "author": "kvoon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvoon9/weila-work.git",
    "directory": "packages/cli"
  },
  "bin": {
    "weila-work-cli": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.mjs",
    "prepublishOnly": "pnpm run build",
    "bump": "bumpp",
    "sync:skills": "node ../../scripts/sync-skills-to-repo.mjs",
    "publish:skills": "node ../../scripts/sync-skills-to-repo.mjs --push"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "md5": "^2.3.0",
    "unstorage": "^1.17.3"
  },
  "devDependencies": {
    "@types/md5": "catalog:",
    "@types/node": "catalog:",
    "@wl/network": "link:~/i/wl-network",
    "bumpp": "^11.1.0",
    "tsdown": "^0.16.7",
    "typescript": "catalog:"
  }
}
