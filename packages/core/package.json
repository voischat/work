{
  "name": "@vois/weila-sdk-core",
  "version": "2.0.0",
  "private": false,
  "description": "微喇网页SDK",
  "keywords": [],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Jack Chen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvoon9/weila-js-sdk.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "main": "dist/weilasdk.mjs",
  "module": "dist/weilasdk.mjs",
  "types": "dist/weilasdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/weilasdk.d.ts",
      "import": "./dist/weilasdk.mjs"
    },
    "./data": {
      "types": "./dist/weilasdk_data.d.ts",
      "import": "./dist/weilasdk_data.mjs"
    },
    "./log": {
      "types": "./dist/weilasdk_log.d.ts",
      "import": "./dist/weilasdk_log.mjs"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:run": "vitest run",
    "test:dist": "playwright test",
    "build": "pnpm run build:worklets && rspack build --config rspack.config.mts && pnpm run build:declarations",
    "build:dev": "pnpm run build:worklets && rspack build --config rspack.config.mts --mode development && pnpm run build:declarations",
    "build:watch": "pnpm run build:worklets && rspack build --config rspack.config.mts --watch",
    "build:worklets": "rspack build --config rspack.worklets.config.mts",
    "build:declarations": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "pnpm run build:watch",
    "typecheck": "tsrs --noEmit --fast",
    "typecheck:tsc": "tsc --noEmit",
    "test:integration": "pnpm run build && playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "ali-oss": "catalog:",
    "crypto-js": "catalog:",
    "dexie": "catalog:",
    "long": "catalog:",
    "protobufjs": "catalog:",
    "tiny-emitter": "catalog:",
    "tiny-pinyin": "catalog:",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@types/ali-oss": "catalog:",
    "@types/crypto-js": "catalog:",
    "@types/node": "catalog:",
    "fake-indexeddb": "catalog:",
    "gently-copy": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "protobufjs-cli": "catalog:",
    "tsrs": "catalog:native",
    "typescript": "catalog:native",
    "vitest": "catalog:",
    "worker-rspack-loader": "catalog:"
  }
}
