# Environment Configuration Example
# Copy this file to .env and update with your actual values

# API Configuration
VITE_API_BASE_URL=http://localhost:8080

# Weila Platform Configuration
VITE_WEB_SOCK=wss://wss.weila.hk:8899
VITE_WL_APPID=your_weila_app_id_here
VITE_WL_APPKEY=your_weila_app_key_here

# Google Maps API Key
VITE_GOOGLE_MAP_KEY=your_google_maps_api_key_here

# Development/Production Mode
VITE_NODE_ENV=development

# Application Configuration
VITE_APP_TITLE="Weila Enterprise Management System"
VITE_APP_VERSION=1.0.0

# Internationalization
VITE_DEFAULT_LOCALE=zh-CN
VITE_FALLBACK_LOCALE=en

# Feature Flags
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_ANALYTICS=false

# Security
VITE_CSRF_TOKEN_NAME=X-CSRF-TOKEN
VITE_JWT_SECRET=your_jwt_secret_here

# Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Logging
VITE_LOG_LEVEL=info
VITE_ENABLE_CONSOLE_LOGS=true
