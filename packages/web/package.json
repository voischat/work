  "scripts": {
    "dev": "vite",
    "dev:prod": "cross-env NODE_ENV=production vite",
    "build:staging": "vite build --mode staging",
    "build": "vite build",
    "report": "cross-env REPORT=true npm run build",
    "preview": "vite preview --host",
    "preview-https": "vite preview --host",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "up": "taze -I major",
    "prepare": "simple-git-hooks",
    "lint": "eslint .",
    "mock": "apipost-mock-gen fixtures/mock/weila.md --output generated/mock/weila.ts",
    "archive": "esno scripts/archive.ts",
    "test": "vitest",
    "release": "npx bumpp && esno scripts/release.ts",
    "pack": "nr release && nr build && nr archive",
    "electron": "electron electron/main.cjs",
    "electron:build": "node scripts/prepare-agent.cjs && vite build && node scripts/fix-electron-build.cjs && electron-builder",
    "electron:build:dir": "node scripts/prepare-agent.cjs && vite build && node scripts/fix-electron-build.cjs && electron-builder --dir"
  },
