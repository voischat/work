{
  "name": "weila-work",
  "version": "1.0.0",
  "private": true,
  "description": "Weila monorepo: web SDK packages and the enterprise management app",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "pnpm -C apps/website run dev",
    "dev:prod": "pnpm -C apps/website run dev:prod",
    "dev:sdk": "turbo run dev --filter=@vois/weila-sdk-core --filter=@vois/weila-sdk-ui --filter=@weilasdk/playground-vue3",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=weila-work-web",
    "build:staging": "turbo run build:staging --filter=weila-work-web",
    "build:core": "turbo run build --filter=@vois/weila-sdk-core",
    "build:ui": "turbo run build --filter=@vois/weila-sdk-ui",
    "build:story": "turbo run build:story --filter=@vois/weila-sdk-ui",
    "story": "turbo run story --filter=@vois/weila-sdk-ui",
    "preview": "pnpm -C apps/website run preview",
    "typecheck": "turbo run typecheck",
    "typecheck:sdk": "turbo run typecheck --filter='./packages/*'",
    "typecheck:tsc": "turbo run typecheck:tsc",
    "typecheck:parity": "node packages/core/scripts/typecheck-parity.ts",
    "typecheck:strict-budget": "node packages/core/scripts/strict-budget.ts",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "test:scripts": "node --test packages/core/scripts/*.spec.ts scripts/*.spec.ts scripts/release/*.spec.ts",
    "lint": "pnpm run lint:names && pnpm run lint:web && pnpm run lint:sdk && pnpm run lint:comments",
    "lint:names": "ls-lint",
    "lint:web": "eslint apps/website --max-warnings 0",
    "lint:sdk": "node packages/core/scripts/lint-budget.ts",
    "lint:fix": "eslint --fix apps/website",
    "lint:budget": "node packages/core/scripts/lint-budget.ts --write",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "env:setup": "node scripts/env-setup.ts",
    "knip": "knip",
    "up": "pnpm dlx taze -Ir major",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "api:snapshot": "tsnapi packages/core",
    "api:snapshot:update": "tsnapi packages/core -u",
    "contract:baseline": "node packages/core/scripts/artifact-contract.ts --write",
    "contract:check": "node packages/core/scripts/artifact-contract.ts",
    "prepare": "simple-git-hooks",
    "postinstall": "pnpm run build:sdk",
    "lint:staged": "nano-staged",
    "manifests": "node scripts/manifest-checks.ts",
    "build:sdk": "turbo run build --filter='./packages/*'",
    "typecheck:tsc:sdk": "turbo run typecheck:tsc --filter='./packages/*'",
    "test:sdk": "turbo run test:run --filter='./packages/*'",
    "lint:comments": "node scripts/no-comments.ts",
    "lint:workflows": "node scripts/lint-workflows.ts",
    "release": "bumpp apps/website/package.json --tag 'v{version}' --commit 'chore: release v{version}'",
    "release:core": "bumpp packages/core/package.json --tag '@vois/weila-sdk-core@{version}' --commit 'chore(release): @vois/weila-sdk-core@{version}'",
    "release:ui": "bumpp packages/ui/package.json --tag '@vois/weila-sdk-ui@{version}' --commit 'chore(release): @vois/weila-sdk-ui@{version}'",
    "mock": "pnpm -C apps/mock run dev"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@intlify/eslint-plugin-vue-i18n": "catalog:",
    "@ls-lint/ls-lint": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "bumpp": "catalog:",
    "changelogithub": "catalog:",
    "eslint": "catalog:",
    "eslint-factory": "catalog:",
    "eslint-plugin-slop": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-unimport": "catalog:",
    "knip": "catalog:",
    "nano-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "pkg-pr-new": "catalog:",
    "playwright": "catalog:",
    "simple-git-hooks": "catalog:",
    "taze": "catalog:",
    "tsdown": "catalog:",
    "tsnapi": "catalog:",
    "tsrs": "catalog:native",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitepress": "catalog:",
    "void": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "packages/**/*.{js,jsx,ts,tsx,mjs,cjs,vue}": [
      "ls-lint",
      "oxlint --type-aware",
      "oxfmt --check"
    ],
    "packages/**/*.{json,jsonc,md,mdx,css,pcss,html,yml,yaml}": "oxfmt --check",
    "apps/playground-vue3/**/*.{js,jsx,ts,tsx,mjs,cjs,vue}": [
      "ls-lint",
      "oxlint --type-aware",
      "oxfmt --check"
    ],
    "apps/website/**/*.{js,jsx,ts,tsx,mjs,cjs,vue,md,mdx,css,pcss,html,json,jsonc,yml,yaml}": [
      "ls-lint",
      "eslint --fix"
    ],
    "**/*.{vue,css,less,pcss,html}": "pnpm run lint:comments",
    "**/{package.json,pnpm-workspace.yaml}": "pnpm run manifests"
  },
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.23.0"
}
