{
  "name": "weila-crop-mgr",
  "version": "1.0.0",
  "packageManager": "pnpm@10.20.0",
  "description": "",
  "author": "",
  "license": "ISC",
  "pnpm": {
    "overrides": {
      "@wl/network": "npm:@vois/weila-network@^0.0.7"
    }
  },
  "keywords": [],
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -C packages/web run dev",
    "dev:prod": "pnpm -C packages/web run dev:prod",
    "build": "pnpm -C packages/web run build",
    "build:staging": "pnpm -C packages/web run build:staging",
    "preview": "pnpm -C packages/web run preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint-staged": "npx lint-staged",
    "up": "nlx taze -I major",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "cli:dev": "pnpm -C packages/cli run dev",
    "cli:build": "pnpm -C packages/cli run build",
    "cli:start": "pnpm -C packages/cli start",
    "agent:dev": "pnpm -C packages/agent run dev",
    "agent:build": "pnpm -C packages/agent run build",
    "electron": "pnpm -C packages/web run electron"
  },
  "dependencies": {
    "dayjs": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@antfu/ni": "catalog:",
    "@intlify/eslint-plugin-vue-i18n": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-factory": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-unimport": "catalog:",
    "lint-staged": "catalog:",
    "octokit": "catalog:",
    "oxc-minify": "0.137.0",
    "simple-git-hooks": "catalog:",
    "unbuild": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitepress": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}